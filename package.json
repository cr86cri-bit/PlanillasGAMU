{
  "name": "sistema-planillas-gamu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:cloudflare": "npm run build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier . --write",
    "test": "vitest run"
  },
  "dependencies": {
    "jspdf": "2.5.2",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "eslint": "9.14.0",
    "prettier": "3.3.3",
    "vite": "5.4.11",
    "vitest": "2.1.5",
    "wrangler": "4.123.0"
  }
}
